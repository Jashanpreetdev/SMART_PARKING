<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".NavigationActivity">

    <!-- Location Input -->
    <EditText
        android:id="@+id/locationInput"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="  Enter your location"
        android:drawableStart="@drawable/vector"
        android:background="@drawable/rounded_input"
        android:padding="12dp"
        android:textSize="20sp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dynamic User Name -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello, User"
        android:textSize="15sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textColor="@color/green"
        android:layout_marginTop="30dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/locationInput"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- App Tagline -->
    <TextView
        android:id="@+id/taglineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Parking Made Simple"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:fontFamily="serif"
        android:paddingLeft="10dp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Choose Vehicle Type -->
    <TextView
        android:id="@+id/chooseVehicleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Your Vehicle Type:"
        android:textSize="12sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="25dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/taglineText"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Vehicle Selection Layout -->
    <LinearLayout
        android:id="@+id/vehicleSelectionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/chooseVehicleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Car -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/carButton"
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_car"
                android:background="@drawable/vehicle_selector"
                android:scaleType="fitCenter"
                android:elevation="8dp"
                android:contentDescription="Car"/>

            <TextView
                android:id="@+id/carText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Car"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Bike -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/bikeButton"
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_bike"
                android:background="@drawable/vehicle_selector"
                android:elevation="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Bike"/>

            <TextView
                android:id="@+id/bikeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bike"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Bus -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/busButton"
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_bus"
                android:background="@drawable/vehicle_selector"
                android:elevation="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Jeep"/>

            <TextView
                android:id="@+id/busText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jeep"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Car Dropdown Layout -->
    <LinearLayout
        android:id="@+id/carDropdownLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vehicleSelectionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Spinner
            android:id="@+id/vehicleBrandDropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:elevation="8dp"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/vehicleModelDropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:elevation="8dp"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Timing Input Layout (For Car) -->
    <LinearLayout
        android:id="@+id/carTimingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/carDropdownLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/fromDateCar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:hint="From Date:"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilDateCar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:focusable="false"
            android:clickable="true"
            android:hint="Until Date:"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/fromTimeCar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:hint="From Time:"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilTimeCar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:focusable="false"
            android:clickable="true"
            android:hint="Until Time:"
            android:textSize="16sp"/>


    </LinearLayout>


    <!-- Bike Timing Layout -->
    <LinearLayout
        android:id="@+id/bikeTimingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/vehicleSelectionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/fromDateBike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:hint="From Date:"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:inputType="date"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilDateBike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:hint="Until Date:"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:inputType="date"/>


        <EditText
            android:id="@+id/fromTimeBike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:hint="From Time:"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:inputType="time"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilTimeBike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:hint="Until Time:"
            android:padding="12dp"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:inputType="time"/>


    </LinearLayout>



    <!-- Bus Input Layout -->
    <LinearLayout
        android:id="@+id/busDropdownLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vehicleSelectionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Spinner
            android:id="@+id/busLengthDropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:padding="12dp"
            android:elevation="8dp"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/busWidthDropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:padding="12dp"
            android:elevation="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>

    <!-- Timing Input Layout (For Bus) -->
    <LinearLayout
        android:id="@+id/busTimingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/busDropdownLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/fromDateBus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:padding="12dp"
            android:focusable="false"
            android:textColorHint="#888888"
            android:clickable="true"
            android:hint="From Date"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilDateBus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:hint="Until Date"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/fromTimeBus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:padding="12dp"
            android:focusable="false"
            android:textColorHint="#888888"
            android:clickable="true"
            android:hint="From: Today at 13:00"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/untilTimeBus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:hint="Until: Today at 16:00"
            android:textSize="16sp"/>


    </LinearLayout>



    <!-- Find Parking Space Button -->
    <Button
        android:id="@+id/findSpaceButton"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Find Your Space"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/green"
        android:textSize="18sp"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>