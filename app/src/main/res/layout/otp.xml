<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="100dp">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the 4-digit code sent to"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="abcd*@gmail.com"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/tvChangeEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change your e-mail?"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <EditText
                android:id="@+id/etCode1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberPassword"
                android:gravity="center"
                android:background="@drawable/otp_background"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:maxLength="1"
                android:padding="10dp"
                android:ems="1"/>

            <EditText
                android:id="@+id/etCode2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberPassword"
                android:gravity="center"
                android:background="@drawable/otp_background"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:maxLength="1"
                android:padding="10dp"
                android:ems="1"
                android:layout_marginStart="10dp"/>

            <EditText
                android:id="@+id/etCode3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberPassword"
                android:gravity="center"
                android:background="@drawable/otp_background"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:maxLength="1"
                android:padding="10dp"
                android:ems="1"
                android:layout_marginStart="10dp"/>

            <EditText
                android:id="@+id/etCode4"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberPassword"
                android:gravity="center"
                android:background="@drawable/otp_background"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:maxLength="1"
                android:padding="10dp"
                android:ems="1"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnResendCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend code via another e-mail"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@android:color/black"
            android:layout_marginTop="50dp"
            android:textAlignment="center"
            android:layout_marginBottom="50dp"/>

        <ImageView
            android:id="@+id/imgCar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_image"
            android:scaleType="fitCenter"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</ScrollView>
